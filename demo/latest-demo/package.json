{
  "name": "latest-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' vite build && mkdir -p .output/server && cp instrument.server.mjs .output/server",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "deploy": "pnpm run build && wrangler deploy",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.0",
    "@faker-js/faker": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/tanstackstart-react": "^10.38.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "latest",
    "@tanstack/ai-anthropic": "latest",
    "@tanstack/ai-client": "latest",
    "@tanstack/ai-gemini": "latest",
    "@tanstack/ai-ollama": "latest",
    "@tanstack/ai-openai": "latest",
    "@tanstack/ai-react": "latest",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/query-db-collection": "^1.0.23",
    "@tanstack/react-ai-devtools": "latest",
    "@tanstack/react-db": "^0.1.70",
    "@tanstack/react-devtools": "^0.7.11",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.159.5",
    "@tanstack/react-router-devtools": "^1.159.5",
    "@tanstack/react-router-ssr-query": "^1.159.5",
    "@tanstack/react-start": "^1.159.5",
    "@tanstack/react-store": "^0.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.159.5",
    "@tanstack/store": "^0.8.0",
    "dotenv-cli": "^11.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "streamdown": "^1.6.11",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@tanstack/devtools-event-client": "^0.4.0",
    "@tanstack/devtools-vite": "^0.3.12",
    "@tanstack/eslint-config": "^0.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "~3.2.4",
    "wrangler": "^4.65.0"
  }
}
